---
layout: layouts/base.njk
schemaVariant: inner
title: About Anthony Long · Anthony Long Realty (demo)
description: About the Anthony Long Realty demo with a placeholder biography, five buying steps, and five selling steps. Phone, email, and license stay marked as placeholders.
permalink: about/index.html
---
<div class="wrapper page-layout">
  <h1>About Anthony Long Realty</h1>

  <section class="split" aria-labelledby="bio-title">
    <div class="portrait" role="img" aria-label="Placeholder headshot for Anthony Long">
      <span class="portrait__monogram" aria-hidden="true">AL</span>
      <span class="portrait__label">Placeholder portrait. No photo is on file.</span>
    </div>
    <div>
      <h2 id="bio-title">Meet Anthony</h2>
      <div class="prose">
        {% for paragraph in copy.bio %}
        <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
    </div>
  </section>

  <section aria-labelledby="contact-facts-title">
    <h2 id="contact-facts-title">Contact details</h2>
    <div class="prose">
      <p>Phone: {{ site.placeholder }}</p>
      <p>Email: {{ site.placeholder }}</p>
      <p>Office: {{ site.placeholder }}</p>
      <p>License: {{ site.placeholder }}</p>
    </div>
  </section>

  <section id="process" aria-labelledby="process-title">
    <h2 id="process-title">Process</h2>
    <h3>Buying</h3>
    <ol class="steps-grid">
      {% for step in process.buying %}
      <li class="step-card">
        <h4 class="step-card__title">{{ step.title }}</h4>
        {% if step.note %}<p class="step-note">{{ step.note }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
    <h3>Selling</h3>
    <ol class="steps-grid">
      {% for step in process.selling %}
      <li class="step-card">
        <h4 class="step-card__title">{{ step.title }}</h4>
        {% if step.note %}<p class="step-note">{{ step.note }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>

  <section aria-labelledby="cities-title">
    <h2 id="cities-title">Cities we discuss</h2>
    <div class="area-grid">
      {% for city in areas.cities %}
      <a class="area-link" href="{{ ('/areas/' ~ city.slug ~ '/') | url }}">{{ city.name }}</a>
      {% endfor %}
    </div>
  </section>

  <div class="btn-row">
    <a class="btn btn--primary" href="{{ '/contact/' | url }}">Contact</a>
    <a class="btn btn--outline" href="{{ '/home-value/' | url }}">Home value</a>
  </div>
</div>
