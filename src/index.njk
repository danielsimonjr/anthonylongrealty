---
layout: layouts/base.njk
schemaVariant: home
title: Anthony Long Realty (demo) · DeSoto & SW Dallas County
description: Demo site for Anthony Long Realty in DeSoto and southwest Dallas County. Placeholder portrait and reviews. Forms on this site do not send.
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrapper hero__inner">
    <h1 id="hero-title">Local. Honest.<span class="hero__script">Your neighbor.</span></h1>
    <p class="hero__lead">I help buyers and sellers in DeSoto, Cedar Hill, Duncanville, Lancaster, Red Oak, Midlothian, and nearby cities. This demo uses placeholders until Anthony supplies real details.</p>
    <div class="hero__paths">
      <a class="path-btn" href="{{ '/buy/' | url }}"><span>Buy</span><span aria-hidden="true">→</span></a>
      <a class="path-btn" href="{{ '/sell/' | url }}"><span>Sell</span><span aria-hidden="true">→</span></a>
      <a class="path-btn" href="{{ '/home-value/' | url }}"><span>What's my home worth?</span><span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="section wrapper split" aria-labelledby="meet-title">
  <div class="portrait" role="img" aria-label="Placeholder headshot for Anthony Long">
    <span class="portrait__monogram" aria-hidden="true">AL</span>
    <span class="portrait__label">Placeholder portrait. No photo is on file.</span>
  </div>
  <div>
    <p class="section__eyebrow">Meet Anthony</p>
    <h2 id="meet-title">Your neighbor in real estate</h2>
    <div class="prose">
      {% for paragraph in copy.bio %}
      <p>{{ paragraph }}</p>
      {% endfor %}
      <p><a href="{{ '/about/' | url }}">More about the practice</a></p>
    </div>
  </div>
</section>

<section class="section section--mist wrapper" aria-labelledby="buy-steps-title">
  <p class="section__eyebrow">Buying with me</p>
  <h2 id="buy-steps-title" class="section__title">Five steps to your next home</h2>
  <ol class="steps-grid">
    {% for step in process.buying %}
    <li class="step-card">
      <h3 class="step-card__title">{{ step.title }}</h3>
      {% if step.note %}<p class="step-note">{{ step.note }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <div class="loan-strip" aria-labelledby="loan-title">
    <p class="section__eyebrow section__eyebrow--gold" id="loan-title">Loan types we discuss</p>
    <p class="prose">{{ loans.intro }}</p>
    <div class="loan-grid">
      {% for loan in loans.items %}
      <article class="loan-card card">
        <h3>{{ loan.title }}</h3>
        <p>{{ loan.body }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
  <p class="prose" style="margin-block-start: var(--space-5);"><a href="{{ '/buy/' | url }}">See the full buying page</a></p>
</section>

<section class="section wrapper" aria-labelledby="sell-steps-title">
  <p class="section__eyebrow">Selling with me</p>
  <h2 id="sell-steps-title" class="section__title">Five steps to a smooth sale</h2>
  <ol class="steps-grid">
    {% for step in process.selling %}
    <li class="step-card">
      <h3 class="step-card__title">{{ step.title }}</h3>
      {% if step.note %}<p class="step-note">{{ step.note }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <div class="btn-row" style="margin-block-start: var(--space-5);">
    <a class="btn btn--primary" href="{{ '/home-value/' | url }}">What's my home worth?</a>
    <a class="btn btn--outline" href="{{ '/sell/' | url }}">Selling page</a>
  </div>
</section>

<section class="section section--paper wrapper" aria-labelledby="listings-title">
  <h2 id="listings-title" class="section__title">Featured listings</h2>
  <p class="prose">{{ listings.disclaimer }}</p>
  <div class="card-grid card-grid--listings">
    {% for listing in listings.items %}
    {% include "partials/listing-card.njk" %}
    {% endfor %}
  </div>
  <p><a href="{{ '/listings/' | url }}">View all sample listings</a></p>
</section>

<section class="section section--mist wrapper" aria-labelledby="areas-grid-title">
  <h2 id="areas-grid-title" class="section__title">Neighborhood guides</h2>
  <p class="prose">{{ areas.indexIntro }}</p>
  <div class="area-grid">
    {% for city in areas.cities %}
    <a class="area-link" href="{{ ('/areas/' ~ city.slug ~ '/') | url }}">{{ city.name }}</a>
    {% endfor %}
  </div>
  <p style="margin-block-start: var(--space-4);"><a href="{{ '/areas/' | url }}">Browse all area guides</a></p>
</section>

<section class="section wrapper" aria-labelledby="quotes-title">
  <p class="section__eyebrow">Testimonials</p>
  <h2 id="quotes-title" class="section__title">What neighbors say</h2>
  <p class="stars" aria-hidden="true">★★★★★</p>
  <div class="card-grid">
    {% for quote in quotes.items %}
    {% include "partials/quote.njk" %}
    {% endfor %}
  </div>
  <p><a href="{{ '/reviews/' | url }}">Reviews page</a></p>
</section>

<section class="contact-band" aria-labelledby="closing-title">
  <div class="wrapper split">
    <div>
      <h2 id="closing-title">Let's talk</h2>
      <p class="prose">Tell me what you are trying to do. This demo form does not send, and the phone line above is a placeholder until Anthony shares a real number.</p>
      <p>Phone: {{ site.placeholder }}</p>
    </div>
    <div>
      {% include "partials/lead-form.njk" %}
    </div>
  </div>
</section>
