<article class="card listing-card">
  <span class="badge">Sample</span>
  <div class="listing-panel" aria-hidden="true">{{ listing.city }}</div>
  <h3>{{ listing.title }}</h3>
  <p>{{ listing.address }}</p>
  <p>{{ listing.price }}</p>
  <p><a href="{{ '/contact/?topic=buying' | url }}">Ask about a real search</a></p>
</article>
