<form
  class="form-grid"
  method="post"
  action="#value-demo"
  data-formspree-action=""
  data-demo-form="value"
>
  <!-- Future Formspree endpoint: https://formspree.io/f/REPLACE_ME -->
  <div class="hp-field" aria-hidden="true">
    <label for="value-company">Company</label>
    <input id="value-company" name="company" type="text" tabindex="-1" autocomplete="off">
  </div>

  <label for="value-name">Name</label>
  <input id="value-name" name="name" type="text" required autocomplete="name">

  <label for="value-email">Email</label>
  <input id="value-email" name="email" type="email" required autocomplete="email">

  <label for="value-phone">Phone (optional)</label>
  <input id="value-phone" name="phone" type="tel" autocomplete="tel">

  <label for="value-city">City</label>
  <select id="value-city" name="city" required>
    <option value="" disabled selected hidden>Select a city</option>
    <option value="DeSoto">DeSoto</option>
    <option value="Cedar Hill">Cedar Hill</option>
    <option value="Duncanville">Duncanville</option>
    <option value="Lancaster">Lancaster</option>
    <option value="Other">Other</option>
  </select>

  <label for="value-street">Street address (optional)</label>
  <input id="value-street" name="street" type="text" autocomplete="address-line1" placeholder="Your address text">

  <label for="value-timeframe">Timeframe</label>
  <select id="value-timeframe" name="timeframe" required>
    <option value="" disabled selected hidden>Select a timeframe</option>
    <option value="curious">Curious about value</option>
    <option value="this-year">Planning this year</option>
    <option value="already-listed">Already listed elsewhere</option>
  </select>

  <label for="value-note">Note (optional)</label>
  <textarea id="value-note" name="note" placeholder="Anything else to mention?"></textarea>

  <button class="btn btn--primary" type="submit">Submit demo form</button>
</form>
<p id="value-demo" class="form-status" hidden tabindex="-1">This demo did not send your request and did not calculate a value.</p>
