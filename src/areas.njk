---
layout: layouts/base.njk
schemaVariant: inner
title: Area guides · Anthony Long Realty (demo)
description: Demo city guides for six southwest Dallas County cities with Anthony Long Realty. Each guide explains buying and selling steps with placeholders—not a live search.
permalink: areas/index.html
---
<div class="wrapper page-layout">
  <h1>Area guides</h1>
  <p class="prose">{{ areas.indexIntro }}</p>
  <div class="area-grid">
    {% for city in areas.cities %}
    <a class="area-link" href="{{ ('/areas/' ~ city.slug ~ '/') | url }}">{{ city.name }}</a>
    {% endfor %}
  </div>
  <div class="card-grid" style="margin-block-start: var(--space-6);">
    {% for city in areas.cities %}
    <article class="card">
      <h2 class="card__title">{{ city.name }}</h2>
      <p>{{ city.blurb }}</p>
      <p><a href="{{ ('/areas/' ~ city.slug ~ '/') | url }}">{{ city.name }} guide</a></p>
    </article>
    {% endfor %}
  </div>
</div>
